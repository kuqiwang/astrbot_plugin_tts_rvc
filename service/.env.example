# TTS-RVC 声音服务配置
# 复制成 service/.env 后按需修改；也可以不建这个文件，全部用默认值。

# rvc-next 的地址（安装脚本默认 7868）
RVC_URL=http://127.0.0.1:7868

# 默认音色 id（对应 rvc-next 模型库里的 id）
# 留空 = 自动用模型库里的第一个音色
VOICE_ID=

# 底声：edge-tts 的说话人
# 女声：zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural
# 男声：zh-CN-YunxiNeural / zh-CN-YunjianNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 变调（半音）：同性别 0；男声底→女声约 +12，女声底→男声约 -12
PITCH=0

# 索引贴合度 0~1：越高越贴模型音色
INDEX_RATE=0.75

# 齿音/气声保护 0~0.5
PROTECT=0.33

# 音高提取算法：rmvpe（默认，质量最好）/ harvest / crepe
F0_METHOD=rmvpe

# 单个 RVC 任务最多等多久（秒）
JOB_TIMEOUT=120

# 情绪映射：1 开 / 0 关
EMOTION_ENABLED=1
# 情绪强度倍率
EMOTION_SCALE=1.0

# 单条文本上限（字）
MAX_TEXT_CHARS=500

# 服务监听地址与端口
# 只建议 127.0.0.1；改成 0.0.0.0 会暴露到局域网
HOST=127.0.0.1
PORT=9880

# 启动时预热（1 开 / 0 关）：提前把模型加载进显存，第一条不卡
WARMUP=0
